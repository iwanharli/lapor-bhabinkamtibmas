NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://lapor:lapor@localhost:5432/lapor_dev
JWT_ACCESS_SECRET=ganti-dengan-rahasia-panjang
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_MOBILE=2592000
JWT_REFRESH_TTL_WEB=43200
CORS_ORIGINS=http://localhost:3001
MIN_APP_VERSION=1.0.0
SEED_SUPERADMIN_NRP=00000001
SEED_SUPERADMIN_PASSWORD=GantiSegera#2026
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Kunci AES-256 untuk field sensitif (NIK dll). Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=k1:GANTI-DENGAN-BASE64-32-BYTE
# Batas percobaan login per IP per menit (produksi: 10; dev/CI boleh lebih longgar)
LOGIN_RATE_LIMIT=10
# Interval penyegaran agregat analitik (detik); 0 = nonaktif di instance ini
AGG_REFRESH_SECONDS=60
# Peta: di atas jumlah titik ini per tampilan, server mengirim gugus (cluster)
MAP_POINT_LIMIT=1500
# Kompresi foto lampiran saat unggah (sisi terpanjang px, kualitas JPEG)
PHOTO_MAX_EDGE=1920
PHOTO_QUALITY=78
# Antrean ekspor CSV: selang cek (ms, 0 = worker mati di proses ini), masa simpan berkas (jam), batas baris
EXPORT_POLL_MS=2000
EXPORT_KEEP_HOURS=24
EXPORT_MAX_ROWS=200000
# Absensi: check-in setelah jam ini (waktu setempat) ditandai terlambat
ATTENDANCE_LATE_AFTER=08:00
# Laporan terkirim langsung final (tanpa verifikasi); pelapor boleh meralat selama ini (jam)
REPORT_RALAT_HOURS=72
