// Skema fase 1: organisasi, wilayah, pengguna, perangkat, master data, skema form, audit.
// Tabel laporan & absensi ditambahkan di fase 2 (lihat docs/teknis/04-database.md).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto]
}

enum UnitLevel {
  MABES
  POLDA
  POLRES
  POLSEK

  @@map("unit_level")
}

enum UserRole {
  BHABIN
  VERIFIKATOR
  PIMPINAN
  ADMIN_UNIT
  SUPERADMIN
  AUDITOR
  INTEGRASI

  @@map("user_role")
}

enum ReportCategory {
  SAMBANG
  DETEKSI_DINI
  PROBLEM_SOLVING
  PENYULUHAN
  HARGA_PANGAN
  MAPPING_KK
  KETAHANAN_PANGAN

  @@map("report_category")
}

model Unit {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  level     UnitLevel
  kode      String    @unique @db.VarChar(32)
  nama      String    @db.VarChar(150)
  timezone  String    @default("Asia/Jakarta") @db.VarChar(32)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  parent   Unit?     @relation("UnitTree", fields: [parentId], references: [id])
  children Unit[]    @relation("UnitTree")
  users    User[]
  villages Village[]
  reports  Report[]

  @@index([parentId])
  @@map("units")
}

model Village {
  id          String                                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kodeWilayah String                                       @unique @map("kode_wilayah") @db.VarChar(13)
  nama        String                                       @db.VarChar(120)
  kecamatan   String                                       @db.VarChar(120)
  kabupaten   String                                       @db.VarChar(120)
  provinsi    String                                       @db.VarChar(120)
  polsekId    String?                                      @map("polsek_id") @db.Uuid
  geom        Unsupported("geometry(MultiPolygon, 4326)")?
  centroid    Unsupported("geography(Point, 4326)")?

  polsek       Unit?         @relation(fields: [polsekId], references: [id])
  userVillages UserVillage[]
  reports      Report[]

  @@index([polsekId])
  @@map("villages")
}

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nrp                String    @unique @db.VarChar(20)
  nama               String    @db.VarChar(150)
  pangkat            String?   @db.VarChar(40)
  jabatan            String?   @db.VarChar(120)
  role               UserRole
  unitId             String    @map("unit_id") @db.Uuid
  phone              String?   @db.VarChar(20)
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  active             Boolean   @default(true)
  failedLogins       Int       @default(0) @map("failed_logins")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  unit          Unit                  @relation(fields: [unitId], references: [id])
  villages      UserVillage[]
  devices       Device[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  reports       Report[]              @relation("ReportAuthor")
  reviewed      Report[]              @relation("ReportReviewer")
  statusChanges ReportStatusHistory[]

  @@index([unitId])
  @@map("users")
}

model UserVillage {
  userId    String    @map("user_id") @db.Uuid
  villageId String    @map("village_id") @db.Uuid
  since     DateTime  @default(now()) @db.Date
  until     DateTime? @db.Date

  user    User    @relation(fields: [userId], references: [id])
  village Village @relation(fields: [villageId], references: [id])

  @@id([userId, villageId, since])
  @@map("user_villages")
}

model Device {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  deviceId   String    @map("device_id") @db.VarChar(128)
  platform   String    @db.VarChar(10)
  model      String?   @db.VarChar(100)
  appVersion String?   @map("app_version") @db.VarChar(20)
  pushToken  String?   @map("push_token")
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([userId, deviceId])
  @@map("devices")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  deviceId  String?   @map("device_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  /// Diisi bila dicabut karena rotasi (bukan logout/pencabutan), untuk masa toleransi request paralel.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])

  @@map("refresh_tokens")
}

model Commodity {
  id            Int     @id @default(autoincrement())
  kode          String  @unique @db.VarChar(32)
  nama          String  @db.VarChar(80)
  satuanDefault String  @map("satuan_default") @db.VarChar(10)
  urutan        Int     @default(0)
  active        Boolean @default(true)

  items ReportItem[]

  @@map("commodities")
}

model FormSchema {
  id          Int            @id @default(autoincrement())
  category    ReportCategory
  version     Int
  schema      Json
  autoApprove Boolean        @default(false) @map("auto_approve")
  status      String         @default("ACTIVE") @db.VarChar(10)
  publishedAt DateTime       @default(now()) @map("published_at") @db.Timestamptz

  @@unique([category, version])
  @@map("form_schemas")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(60)
  entity    String?  @db.VarChar(40)
  entityId  String?  @map("entity_id")
  meta      Json?
  ip        String?
  userAgent String?  @map("user_agent")
  at        DateTime @default(now()) @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, at(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ===== Fase 2: laporan =====

enum ReportStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_REVISION
  APPROVED
  REJECTED

  @@map("report_status")
}

enum StockStatus {
  AMAN
  MENIPIS
  KOSONG

  @@map("stock_status")
}

enum AttachmentSource {
  CAMERA
  FILE

  @@map("attachment_src")
}

model Report {
  id             String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientUuid     String                                @unique @map("client_uuid") @db.Uuid
  nomor          String?                               @unique @db.VarChar(40)
  category       ReportCategory
  schemaVersion  Int                                   @map("schema_version")
  userId         String                                @map("user_id") @db.Uuid
  unitId         String                                @map("unit_id") @db.Uuid
  villageId      String                                @map("village_id") @db.Uuid
  status         ReportStatus                          @default(DRAFT)
  priority       Boolean                               @default(false)
  data           Json
  sensitive      Bytes?
  occurredAt     DateTime                              @map("occurred_at") @db.Timestamptz
  location       Unsupported("geography(Point, 4326)")? // diisi trigger dari lat/lng
  lat            Float
  lng            Float
  gpsAccuracyM   Float?                                @map("gps_accuracy_m") @db.Real
  isMockLocation Boolean                               @default(false) @map("is_mock_location")
  insideVillage  Boolean?                              @map("inside_village")
  submittedAt    DateTime?                             @map("submitted_at") @db.Timestamptz
  receivedAt     DateTime                              @default(now()) @map("received_at") @db.Timestamptz
  reviewedById   String?                               @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?                             @map("reviewed_at") @db.Timestamptz
  reviewNote     String?                               @map("review_note")
  createdAt      DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                              @updatedAt @map("updated_at") @db.Timestamptz

  user        User                  @relation("ReportAuthor", fields: [userId], references: [id])
  unit        Unit                  @relation(fields: [unitId], references: [id])
  village     Village               @relation(fields: [villageId], references: [id])
  reviewedBy  User?                 @relation("ReportReviewer", fields: [reviewedById], references: [id])
  items       ReportItem[]
  attachments Attachment[]
  history     ReportStatusHistory[]

  @@index([unitId, status, occurredAt(sort: Desc)])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([category, occurredAt(sort: Desc)])
  @@index([villageId])
  @@map("reports")
}

model ReportItem {
  id          BigInt      @id @default(autoincrement())
  reportId    String      @map("report_id") @db.Uuid
  commodityId Int         @map("commodity_id")
  harga       Int
  satuan      String      @db.VarChar(10)
  stok        StockStatus

  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  commodity Commodity @relation(fields: [commodityId], references: [id])

  @@unique([reportId, commodityId])
  @@index([commodityId])
  @@map("report_items")
}

model Attachment {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId    String?          @map("report_id") @db.Uuid
  fieldKey    String           @map("field_key") @db.VarChar(64)
  clientUuid  String           @unique @map("client_uuid") @db.Uuid
  objectKey   String           @map("object_key")
  thumbKey    String?          @map("thumb_key")
  mime        String           @db.VarChar(60)
  sizeBytes   Int              @map("size_bytes")
  sha256      String           @db.Char(64)
  source      AttachmentSource
  capturedAt  DateTime?        @map("captured_at") @db.Timestamptz
  watermarked Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  report Report? @relation(fields: [reportId], references: [id])

  @@index([reportId])
  @@map("attachments")
}

model ReportStatusHistory {
  id         BigInt        @id @default(autoincrement())
  reportId   String        @map("report_id") @db.Uuid
  fromStatus ReportStatus? @map("from_status")
  toStatus   ReportStatus  @map("to_status")
  actorId    String        @map("actor_id") @db.Uuid
  note       String?
  at         DateTime      @default(now()) @db.Timestamptz

  report Report @relation(fields: [reportId], references: [id])
  actor  User   @relation(fields: [actorId], references: [id])

  @@index([reportId, at])
  @@map("report_status_history")
}

model ReportCounter {
  unitId   String         @map("unit_id") @db.Uuid
  category ReportCategory
  period   String         @db.Char(4)
  lastNo   Int            @default(0) @map("last_no")

  @@id([unitId, category, period])
  @@map("report_counters")
}
