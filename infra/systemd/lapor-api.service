[Unit]
Description=Lapor Bhabinkamtibmas - API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=lapor
Group=lapor
WorkingDirectory=/opt/lapor/current/backend
EnvironmentFile=/etc/lapor/api.env
# Kompresi foto (sharp) & argon2 memakai thread pool libuv (default 4): samakan dengan jumlah inti CPU.
Environment=UV_THREADPOOL_SIZE=8
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/lapor /var/log/lapor

[Install]
WantedBy=multi-user.target
